# Banco (o backend recebe esses valores como SPRING_DATASOURCE_* via compose).
# DB_URL aponta pro servico interno: jdbc:postgresql://db:5432/postgres
DB_URL=jdbc:postgresql://db:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=troque_esta_senha

# Chave da API. PRECISA ser igual ao API_SECRET_KEY usado pelo bot.
API_SECURITY_KEY=troque_esta_chave

# Origens liberadas no CORS (sem barra no final), separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://bti-hp-dashboard.vercel.app

# Token do Cloudflare Tunnel. So preencher depois de criar o tunnel no painel
# Zero Trust. Enquanto vazio, nao suba o profile "tunnel".
TUNNEL_TOKEN=
